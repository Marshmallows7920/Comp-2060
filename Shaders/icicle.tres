code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D tex_frg_2;



void fragment() {
// ColorConstant:5
	vec4 n_out5p0 = vec4(0.000000, 0.498039, 1.000000, 1.000000);


// ColorConstant:4
	vec4 n_out4p0 = vec4(0.498039, 1.000000, 1.000000, 1.000000);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// Mix:6
	vec4 n_out6p0 = mix(n_out5p0, n_out4p0, n_out2p0);


// ColorConstant:8
	vec4 n_out8p0 = vec4(1.000000, 1.000000, 1.000000, 1.000000);


// Input:12
	vec2 n_out12p0 = UV;


// VectorDecompose:18
	float n_out18p0 = n_out12p0.x;
	float n_out18p1 = n_out12p0.y;


// MultiplyAdd:24
	float n_in24p1 = 2.00000;
	float n_out24p0 = fma(n_out18p0, n_in24p1, n_out18p1);


// Input:13
	float n_out13p0 = TIME;


// FloatOp:20
	float n_out20p0 = n_out24p0 + n_out13p0;


// FloatOp:16
	float n_in16p1 = 1.00000;
	float n_out16p0 = mod(n_out20p0, n_in16p1);


// FloatOp:22
	float n_in22p1 = 5.00000;
	float n_out22p0 = pow(n_out16p0, n_in22p1);


// FloatFunc:21
	float n_out21p0 = round(n_out22p0);


// FloatOp:23
	float n_in23p1 = 2.00000;
	float n_out23p0 = n_out21p0 / n_in23p1;


// Mix:11
	vec4 n_out11p0 = mix(n_out6p0, n_out8p0, vec4(n_out23p0));


// Output:0
	COLOR.rgb = vec3(n_out11p0.xyz);


}
