code = "shader_type canvas_item;
render_mode blend_mix;




void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;
	float n_out2p1 = n_out2p0.r;
	float n_out2p2 = n_out2p0.g;
	float n_out2p3 = n_out2p0.b;
	float n_out2p4 = n_out2p0.a;


// Input:4
	float n_out4p0 = TIME;


// FloatOp:6
	float n_out6p0 = n_out2p3 * n_out4p0;


// FloatFunc:7
	float n_out7p0 = sin(n_out6p0);


// FloatOp:9
	float n_out9p0 = n_out2p1 * n_out4p0;


// FloatOp:10
	float n_in10p1 = 2.00000;
	float n_out10p0 = n_out9p0 / n_in10p1;


// FloatFunc:8
	float n_out8p0 = sin(n_out10p0);


// VectorCompose:3
	vec3 n_out3p0 = vec3(n_out7p0, n_out2p2, n_out8p0);


// Output:0
	COLOR.rgb = n_out3p0;
	COLOR.a = n_out2p4;


}
