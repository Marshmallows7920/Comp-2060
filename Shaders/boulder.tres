code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D tex_frg_5;



void fragment() {
// ColorConstant:3
	vec4 n_out3p0 = vec4(0.260000, 0.198423, 0.132600, 1.000000);


// ColorConstant:4
	vec4 n_out4p0 = vec4(0.110543, 0.077898, 0.042964, 1.000000);


// Input:14
	vec2 n_out14p0 = UV;


// VectorDecompose:18
	float n_out18p0 = n_out14p0.x;
	float n_out18p1 = n_out14p0.y;


// Input:6
	vec2 n_out6p0 = SCREEN_UV;


// Input:21
	vec2 n_out21p0 = SCREEN_PIXEL_SIZE;


// VectorDecompose:22
	float n_out22p0 = n_out21p0.x;
	float n_out22p1 = n_out21p0.y;


// FloatOp:23
	float n_out23p0 = max(n_out22p0, n_out22p1);


// VectorOp:24
	vec2 n_out24p0 = n_out21p0 / vec2(n_out23p0);


// VectorOp:20
	vec2 n_out20p0 = n_out6p0 / n_out24p0;


// VectorDecompose:10
	float n_out10p0 = n_out20p0.x;
	float n_out10p1 = n_out20p0.y;


// FloatOp:12
	float n_out12p0 = n_out18p0 - n_out10p0;


// FloatOp:16
	float n_in16p1 = 1.00000;
	float n_out16p0 = mod(n_out12p0, n_in16p1);


// FloatOp:13
	float n_out13p0 = n_out18p1 - n_out10p1;


// FloatOp:17
	float n_in17p1 = 1.00000;
	float n_out17p0 = mod(n_out13p0, n_in17p1);


// VectorCompose:11
	vec2 n_out11p0 = vec2(n_out16p0, n_out17p0);


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, n_out11p0);


// Mix:2
	vec4 n_out2p0 = mix(n_out3p0, n_out4p0, n_out5p0);


// Output:0
	COLOR.rgb = vec3(n_out2p0.xyz);


}
